# Copy this file to `.env` for local development. Never commit `.env`.
# On the host (Railway), set these as service variables instead.

# API port (default 3000). If another program already uses 3000, such as a local PostgreSQL, use 3002 and
# start the frontend with NEXT_PUBLIC_API_URL=http://localhost:3002 (it assumes port 3000 otherwise).
PORT=3000
NODE_ENV=development

# PostgreSQL connection string.
# Local example:  postgres://postgres:postgres@localhost:5432/mindmeter
# Supabase: use the Session pooler string from the project's Connect button.
#   postgres://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres
DATABASE_URL=postgres://postgres:postgres@localhost:5432/mindmeter
# Hosted databases (Supabase) require SSL. Set to false only for a local database.
DB_SSL=false
# Supabase only: its CA certificate (Project Settings > Database > SSL Configuration), PEM text on ONE line with \n
# for line breaks. Without it the connection is refused because the certificate is not publicly signed.
DB_SSL_CA=

# Comma-separated list of frontend origins allowed to call the API.
# Leave empty in development to allow any origin. MUST be set in production.
# The Next.js frontend runs on port 3001 locally, or 3005 when 3001 is busy. List every origin you use.
CORS_ORIGIN=http://localhost:3001,http://localhost:3005

# Set to 1 when the API runs behind a proxy (Railway) so the rate limit sees the real client IP.
TRUST_PROXY=
# Requests per minute per IP before 429 (default 60). /api/resources is never limited.
RATE_LIMIT_PER_MIN=

# --- Stage 2 NLP (optional). Leave both empty to keep NLP switched off. ---
# The key is used ONLY by this backend. Never put it in the frontend.
OPENROUTER_API_KEY=
# Exact model string from your OpenRouter dashboard (verify it exists and handles English and Indonesian notes).
OPENROUTER_MODEL=

# --- Demo account (used by `npm run db:seed-demo`) ---
# 16-128 characters: letters, digits, _ or -. The frontend stores the same value in localStorage.
DEMO_ANON_TOKEN=